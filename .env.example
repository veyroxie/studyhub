# StudyHub environment template.
# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored (never commit real secrets).

# ── Required (compose refuses to start if these are empty) ───────────────────
POSTGRES_PASSWORD=          # DB password; any strong string for local dev
JWT_SECRET=                 # min 16 chars; generate with: openssl rand -hex 32

# ── Environment ──────────────────────────────────────────────────────────────
# development = seeds demo data, background jobs OFF, outbound email/push OFF
#               (logged to stdout instead). Fails safe if forgotten.
# production  = admin row only; jobs run; outbound still needs OUTBOUND_ENABLED.
APP_ENV=development

# ── Outbound kill-switch ─────────────────────────────────────────────────────
# Real email + web push require BOTH APP_ENV=production AND OUTBOUND_ENABLED=1.
# Key presence alone never sends — a dev box with prod keys stays silent.
OUTBOUND_ENABLED=

# Run background jobs (billing cron, reminders, email queue) outside
# production. Leave blank in dev unless testing jobs deliberately.
ENABLE_JOBS=

# Boot guard override: allow a non-production env to use a remote database
# (e.g. a restore drill). Leave blank normally.
ALLOW_REMOTE_DB=

# Recipient for built-in health alerts (disk, stale backups, stuck email
# queue, from the hourly self-check). Blank disables alert emails.
ALERT_EMAIL=

# ── URLs (local defaults; set to the real domain in production) ───────────────
ALLOWED_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# Password for the seeded admin@studyhub.com. If blank, a one-time random
# password is generated and printed to the server logs on first run.
SEED_ADMIN_PASSWORD=

# ── Email (Resend) — blank = dev mode, emails logged to stdout ────────────────
RESEND_API_KEY=
EMAIL_FROM=The Study Hub <hello@studyhub.fit>

# ── Web push (VAPID) — blank = push disabled (email + in-app still work) ──────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Postgres dump backup to DO Spaces (optional) ─────────────────────────────
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_HOST=sgp1.digitaloceanspaces.com

# ── Force demo data even in production (1 = on) ──────────────────────────────
SEED_DEMO_DATA=
