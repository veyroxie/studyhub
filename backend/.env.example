# Copy this to .env and fill in your values
# .env is gitignored — never commit real secrets

JWT_SECRET=change-me-to-a-long-random-string-in-production
DB_PATH=studyhub.db
PORT=8080

# CORS: set to your frontend domain in production
# e.g. ALLOWED_ORIGIN=https://app.studyhub.my
ALLOWED_ORIGIN=http://localhost:8080

# Python analytics microservice (optional — only needed for AI/report features)
ANALYTICS_SERVICE_URL=http://localhost:8001

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Sign up at https://resend.com (free tier: 3,000 emails/month, no card required).
# Leaving RESEND_API_KEY blank runs the mailer in DEV MODE — emails are logged
# to stdout instead of sent, so you can copy verification/reset links during
# local development.
RESEND_API_KEY=
EMAIL_FROM=The Study Hub <hello@studyhub.fit>
APP_URL=https://studyhub.fit
