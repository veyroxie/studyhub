# Copy this to .env and fill in your values
# .env is gitignored — never commit real secrets

# ── Core ───────────────────────────────────────────────────────────────────
# REQUIRED. docker-compose refuses to start if JWT_SECRET or POSTGRES_PASSWORD
# is unset. Generate a strong JWT_SECRET, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-in-production
# POSTGRES_PASSWORD is consumed by both the postgres container and the API's
# DATABASE_URL default in docker-compose.yml. Set a strong value in prod.
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
DATABASE_URL=postgres://studyhub:studyhub@localhost:5432/studyhub?sslmode=disable
PORT=8080

# Environment: development | staging | production
# Controls log format (JSON in production, text in dev) and mailer mode.
APP_ENV=development

# CORS: set to your frontend domain in production
ALLOWED_ORIGIN=http://localhost:8080

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Sign up at https://resend.com (free tier: 3,000 emails/month, no card).
# Leave RESEND_API_KEY blank to run in DEV MODE — emails logged to stdout.
RESEND_API_KEY=
EMAIL_FROM=The Study Hub <hello@studyhub.fit>
APP_URL=https://studyhub.fit

# ── Bootstrap admin ────────────────────────────────────────────────────────
# Set on the very first boot — the password for admin@studyhub.com.
# In production this MUST be set; if absent, the server generates a random
# one-time password and logs it to stdout. After first boot (users table
# populated) this variable is ignored.
SEED_ADMIN_PASSWORD=

# Set to 1 to also seed the demo data (sample students/teachers/classes)
# in production. Default: only in non-production environments.
SEED_DEMO_DATA=

# ── Payment gateway ────────────────────────────────────────────────────────
# Default provider — clients can still override per-request via ?provider=…
# Valid values: billplz | stripe
PAYMENT_PROVIDER=billplz

# Billplz (Malaysian: FPX, e-wallets, cards) — billplz.com
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=
# BILLPLZ_API_BASE=https://www.billplz.com/api      # sandbox override

# Stripe (international cards) — stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=https://api.stripe.com            # test override

# ── Uploads ────────────────────────────────────────────────────────────────
# UPLOAD_STORE=local (default) | s3
# When s3, fill in all five credentials below. Works with AWS S3, DO Spaces,
# Backblaze B2, MinIO — anything S3-compatible.
UPLOAD_STORE=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observability ──────────────────────────────────────────────────────────
# Sentry DSN. Backend integration is currently stub-only (replace with the
# official sentry-go SDK when ready). Frontend reads window.SENTRY_DSN —
# inject via the deploy template if you want browser error capture.
SENTRY_DSN=

# ── Optional ───────────────────────────────────────────────────────────────
# LOG_LEVEL=debug          # Force debug logging in non-dev environments
